# Shopify App
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-azure-app-url.azurecontainerapps.io

# Azure AI Foundry (OpenAI-compatible)
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_RESOURCE_NAME=your-resource-name
AZURE_OPENAI_API_KEY=your-key
AZURE_ORCHESTRATOR_MODEL=gpt-4o-mini
AZURE_SPECIALIST_MODEL=gpt-4o-mini

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cache (Upstash Redis)
REDIS_URL=rediss://default:token@host:6379

# WhatsApp Business (Meta) — required for the WhatsApp channel
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Encrypts merchant WhatsApp access tokens at rest — required
ENCRYPTION_KEY=32-byte-random-key

# Shared secret for internal worker endpoints (cart-recovery, review-worker);
# falls back to SHOPIFY_API_SECRET if unset
REVIEW_WORKER_SECRET=your-worker-shared-secret

# QStash (Upstash) — schedules abandoned-cart recovery and review-request jobs
QSTASH_TOKEN=your-qstash-token

# Signs the WhatsApp OAuth state param and session cookies
SESSION_SECRET=your-session-secret

# Optional: LLM backup
OPENROUTER_API_KEY=your-openrouter-key

# Exa neural search — powers the web_search agent tool (shopping research
# beyond the store's own catalog: comparisons, reviews, buying guides)
EXA_API_KEY=your-exa-api-key

# Global Catalog (search_other_stores tool) — searches every Shopify merchant,
# not just this one. Needs a hosted UCP agent profile; normally derived from
# SHOPIFY_APP_URL (see public/.well-known/ucp-agent.json), but before that has
# a real reachable tunnel, override with Shopify's own public sample profile
# for local testing:
# GLOBAL_CATALOG_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/2026-08-25/valid-with-capabilities.json

# Optional: Escalation emails (Resend)
RESEND_API_KEY=your-resend-api-key
