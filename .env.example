# Shopify App
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-azure-app-url.azurecontainerapps.io

# Azure AI Foundry (OpenAI-compatible)
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_RESOURCE_NAME=your-resource-name
AZURE_OPENAI_API_KEY=your-key
AZURE_ORCHESTRATOR_MODEL=gpt-4o-mini
AZURE_SPECIALIST_MODEL=gpt-4o-mini

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cache (Upstash Redis)
REDIS_URL=rediss://default:token@host:6379

# Optional: LLM backup
OPENROUTER_API_KEY=your-openrouter-key

# Optional: Escalation emails (Resend)
RESEND_API_KEY=your-resend-api-key
