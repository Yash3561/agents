generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                     String         @id @default(cuid())
  shopDomain             String         @unique
  plan                   String         @default("free")
  onboardedAt            DateTime?
  conversationCount      Int            @default(0)
  conversationResetAt    DateTime       @default(now())
  widgetColor            String         @default("#1a1a1a")
  widgetPosition         String         @default("bottom-right")
  widgetGreeting         String         @default("Hi! How can I help you today?")
  botName                String         @default("NeonPing")
  brandVoice             String         @default("friendly and helpful")
  maxDiscountPct         Int            @default(15)
  vipCartThreshold       Int            @default(10000)
  supportEmail           String?
  whatsappNumber         String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  personalizationEnabled Boolean        @default(true)
  escalationEmailEnabled Boolean        @default(true)
  excludedPages          String[]       @default([])
  onboardingStep         Int            @default(1)
  customFaqs             Json           @default("[]")
  quickReplies           String[]       @default([])
  conversations          Conversation[]
}

model Conversation {
  id                String   @id @default(cuid())
  shopDomain        String
  sessionId         String
  customerId        String?
  channel           String   @default("shopify_widget")
  messages          Json     @default("[]")
  messageCount      Int      @default(0)
  cartId            String?
  checkoutId        String?
  cartValue         Float?
  resolved          Boolean  @default(false)
  escalated         Boolean  @default(false)
  discountCode      String?
  orderId           String?
  orderRevenueCents Int?
  agentTrace        Json?
  startedAt         DateTime @default(now())
  lastMessageAt     DateTime @updatedAt
  checkoutToken     String?
  merchant          Merchant @relation(fields: [shopDomain], references: [shopDomain])

  @@unique([shopDomain, sessionId])
  @@index([shopDomain])
  @@index([sessionId])
  @@index([orderId])
  @@index([checkoutToken])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
