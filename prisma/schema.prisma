generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                  String         @id @default(cuid())
  shopDomain          String         @unique
  plan                String         @default("free")
  onboardedAt         DateTime?
  conversationCount   Int            @default(0)
  conversationResetAt DateTime       @default(now())
  widgetColor         String         @default("#1a1a1a")
  widgetPosition      String         @default("bottom-right")
  widgetGreeting      String         @default("Hi! How can I help you today?")
  botName             String?        @default("NeonPing")
  brandVoice          String         @default("friendly and helpful")
  personalizationEnabled Boolean     @default(true)
  supportEmail        String?
  escalationEmailEnabled Boolean     @default(false)
  proactiveEngagementEnabled Boolean @default(true)
  excludedPages       String[]       @default([])
  onboardingStep      Int            @default(1)
  customFaqs          Json           @default("[]")
  quickReplies        String[]       @default([])
  insightsJson        Json?
  revenueNarrative    Json?
  whatsappNumber      String?
  wabaId              String?
  waPhoneNumberId     String?
  waAccessToken       String?
  waPhone             String?
  waConnectedAt       DateTime?
  codEnabled          Boolean        @default(false)
  // Opt-in gate: high-stakes AI replies (discount codes, refunds, order cancellation)
  // are held in the Inbox for merchant approval instead of sent immediately. Default off.
  requireApprovalForOffers Boolean   @default(false)
  // When true, this WhatsApp number is a store-agnostic shopping concierge —
  // search_other_stores' Global Catalog (every Shopify merchant) is the primary
  // source, not a this-store-only fallback. See global-concierge.server.ts.
  // shopDomain is still required/unique but need not be a real .myshopify.com
  // store for this mode — it's just a partition key for sessions/memory/billing.
  isGlobalConcierge   Boolean        @default(false)
  trialUsedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  conversations       Conversation[]
  llmUsages           LlmUsage[]
}

model Conversation {
  id                String   @id @default(cuid())
  shopDomain        String
  sessionId         String
  customerId        String?
  messages          Json     @default("[]")
  messageCount      Int      @default(0)
  cartId            String?
  checkoutToken     String?           // real Shopify cart/checkout token parsed from checkout_url, used to match orders/paid webhooks
  cartValue         Float?
  channel           String?
  resolved          Boolean  @default(false)
  escalated         Boolean  @default(false)
  discountCode      String?
  orderId           String?           // set when checkout completed inside chat
  orderRevenueCents Int?              // written by orders/paid webhook
  agentTrace        Json?
  routeReason       String?
  qualityScore      Float?            // AI-judged, written by runQAJudge
  qaMeta            Json?
  merchantThumbsUp   Int      @default(0) // merchant-rated, per-message ratings live in messages[].merchantRating
  merchantThumbsDown Int      @default(0)
  customerEmail     String?
  customerName      String?
  resolvedAt        DateTime?
  startedAt         DateTime @default(now())
  lastMessageAt     DateTime @updatedAt
  firstUserMessage  String?
  aiPaused          Boolean  @default(false)
  merchant          Merchant @relation(fields: [shopDomain], references: [shopDomain])

  @@unique([shopDomain, sessionId])
  @@index([shopDomain])
  @@index([shopDomain, startedAt])
  @@index([shopDomain, channel, startedAt])
  @@index([sessionId])
  @@index([orderId])
  @@index([checkoutToken])
}

/**
 * Daily, per-agent LLM token usage rollup — groundwork for a cost/usage dashboard
 * and for verifying the prompt-cache-alignment work (cachedInputTokens) actually
 * lands provider-side cache hits, not just estimated token counts.
 */
model LlmUsage {
  id                String   @id @default(cuid())
  shopDomain        String
  date              DateTime // truncated to day (UTC midnight)
  agent             String   // "unified" | "whatsapp" | "summary"
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cachedInputTokens Int      @default(0) // subset of inputTokens served from the provider's prompt cache
  callCount         Int      @default(0)
  merchant          Merchant @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@unique([shopDomain, date, agent])
  @@index([shopDomain])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
